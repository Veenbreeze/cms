# Copy this file to .env and fill in real values. Never commit the real .env.

# ---- Django core ----
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ---- Database (Postgres) ----
POSTGRES_DB=cmsa
POSTGRES_USER=cmsa
POSTGRES_PASSWORD=cmsa_dev_password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---- CORS / frontend origin ----
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- JWT ----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_REFRESH_COOKIE_NAME=cmsa_refresh_token
JWT_REFRESH_COOKIE_SECURE=False

# ---- File storage ----
# USE_S3=False stores uploads on local disk under backend/media/
# USE_S3=True stores uploads in an S3-compatible bucket (AWS S3, MinIO, DO Spaces, R2)
USE_S3=True
AWS_STORAGE_BUCKET_NAME=cmsa-media
AWS_S3_ENDPOINT_URL=http://minio:9000
AWS_S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=cmsa_minio_user
AWS_SECRET_ACCESS_KEY=cmsa_minio_password
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=False

# ---- Church defaults ----
JUMUIA_ASSIGNMENT_STRATEGY=least_loaded
DEFAULT_TIMEZONE=Africa/Nairobi
DEFAULT_LANGUAGE=en

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Public base URL of the frontend app — used to build links QR codes point at
# (e.g. the song-sheet page) and other outward-facing links.
FRONTEND_BASE_URL=http://localhost:5173
